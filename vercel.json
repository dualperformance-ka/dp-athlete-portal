{
  "crons": [
    {
      "path": "/api/sync-outbox",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/reminders",
      "schedule": "30 6 * * *"
    }
  ],
  "headers": [
    {
      "source": "/styles.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*).png",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/config.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/call-booked",
      "destination": "/api/bookings?mode=webhook"
    },
    {
      "source": "/api/sync-bookings",
      "destination": "/api/bookings?mode=sync"
    },
    {
      "source": "/api/strava-callback",
      "destination": "/api/strava?mode=callback"
    }
  ]
}